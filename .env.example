# ==============================================================================
# LAN-Drop Self-Hosted Deployment Configuration
# ==============================================================================

# Public Fully Qualified Domain Name (points to host IPv4/IPv6)
DOMAIN_NAME=drop.example.com

# Public IPv4 address of the host server (required for Coturn ICE host candidates)
EXTERNAL_IP=203.0.113.10

# Shared HMAC secret for ephemeral Coturn TURN credentials
# Generate using: openssl rand -hex 32
TURN_SECRET=d3b07384d113edec49eaa6238ad5ff00b95764d142147321e1a4993172e2aa3f

# Comma-separated public STUN servers for WebRTC NAT traversal discovery
STUN_SERVERS=stun:stun.l.google.com:19302,stun:drop.example.com:3478

# Comma-separated TURN servers queried by signaling server via REST API
TURN_SERVERS=turn:drop.example.com:3478?transport=udp,turn:drop.example.com:3478?transport=tcp

# Signaling server internal port
PORT=8080

# Port Range for Coturn UDP Relays (must match docker-compose.yml and firewall rules)
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
