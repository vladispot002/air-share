{
    admin off
}

{$DOMAIN_NAME} {
    encode gzip zstd

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://{$DOMAIN_NAME} ws://{$DOMAIN_NAME}; img-src 'self' data: blob:;"
    }

    # Signaling WebSocket and API Proxy
    reverse_proxy signaling:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Access Logging
    log {
        output stdout
        format json
    }
}
